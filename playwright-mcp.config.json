{
  "browser": {
    "browserName": "chromium",
    "launchOptions": {
      "headless": true
    }
  },
  "network": {
    "allowedOrigins": ["http://127.0.0.1:4200"]
  },
  "outputDir": ".agent-browser-output",
  "capabilities": ["core"],
  "webmcp": false,
  "console": {
    "level": "error"
  }
}
