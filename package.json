{
  "name": "spiewnigator-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --coverage",
    "test-ci": "ng test --no-watch --no-progress",
    "http-server": "npx http-server -p 8080 -c-1 dist/spiewnigator-angular/browser",
    "build-deploy": "ng build --base-href=/spiewnigator-dev/",
    "lint": "ng lint",
    "eslint": "eslint \"src/**/*.{ts,html}\" --cache --ext .ts,.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "fuse.js": "^7.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.3",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@typescript-eslint/types": "^8.50.1",
    "@typescript-eslint/utils": "^8.50.1",
    "@vitest/coverage-v8": "^5.0.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.38.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  }
}
